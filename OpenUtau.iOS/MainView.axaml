<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenUtau.iOS"
             x:Class="OpenUtau.iOS.MainView"
             x:DataType="local:MobileProjectViewModel">
  <Grid RowDefinitions="Auto,Auto,2*,*,Auto" Margin="16" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="{Binding ProjectName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="New" Click="NewProject" />
      <Button Grid.Column="2" Content="Open" Click="OpenProject" />
      <Button Grid.Column="3" Content="Save Copy" Click="SaveProject" />
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Add Note" Click="AddNote" />
      <Button Content="Pitch −" Click="LowerPitch" />
      <Button Content="Pitch +" Click="RaisePitch" />
      <Button Content="Test Audio" Click="TestAudio" />
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="8">
      <local:MobilePianoRoll DataContext="{Binding}" />
    </Border>
    <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
      <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:MobileNoteRow">
            <Border Padding="12" Margin="0,2" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6">
              <TextBlock Text="{Binding Label}" FontSize="18" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <StackPanel Grid.Row="4" Spacing="4">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="iPad mode uses in-process rendering only; external tools and plug-ins are disabled." TextWrapping="Wrap" Opacity="0.65" />
    </StackPanel>
  </Grid>
</UserControl>
